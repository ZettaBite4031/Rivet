CompilationUnit
  ModuleDeclaration
    ModuleKeyword "module"
    Identifier "bootstrap"
    Semicolon ";"
  FunctionDefinition
    IntKeyword "int"
    Identifier "main"
    OpenParen "("
    CloseParen ")"
    BlockStatement
      OpenBrace "{"
      ReturnStatement
        ReturnKeyword "return"
        ErrorExpression <missing>
        Semicolon ";"
      CloseBrace "}"
  EndOfFile ""
